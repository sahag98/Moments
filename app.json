{
  "expo": {
    "name": "Moments",
    "slug": "moments",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#050505",
    "scheme": "moments",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/moments-ios.icon",
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "bundleIdentifier": "com.sahag98.moments",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sahag98.moments",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      ["expo-apple-authentication"],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Moments to use your camera to capture and share photos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Moments access to your photos to save them to your gallery",
          "savePhotosPermission": "Allow Moments to save files to your gallery.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you change your profile picture."
        }
      ],
      ["expo-notifications"],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#168BFF",
          "dark": {
            "backgroundColor": "#168BFF"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "32a6a9ca-0859-4155-a7ba-5c1a92476475"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/32a6a9ca-0859-4155-a7ba-5c1a92476475"
    }
  }
}
