{
  "expo": {
    "name": "Moments",
    "slug": "moments",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#050505",
    "scheme": "moments",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/moments-ios.icon",
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "bundleIdentifier": "com.sahag98.moments",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sahag98.moments"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      ["expo-apple-authentication"],
      ["expo-notifications"],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/image-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0052c8",
          "dark": {
            "backgroundColor": "#0052c8"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "32a6a9ca-0859-4155-a7ba-5c1a92476475"
      }
    }
  }
}
